{
  "name": "wake-up",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "tinacms build --skip-cloud-checks && next build",
    "build-local": "tinacms build --skip-cloud-checks -c \"next build\"",
    "start": "tinacms build && next start",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "next": "15.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinacms": "^3.12.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tinacms/cli": "^2.6.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "better-sqlite3@12.11.1": true,
    "core-js@3.50.0": true
  }
}
